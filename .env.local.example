# eSenZ plant API key — never commit the real value.
# Copy this file to .env.local and fill in your key.
ESENZ_KEY=YOUR_ESENZ_KEY_HERE

# Dashboard sign-in. Both are compared server-side only and never reach the
# browser; without them the app fails closed and nobody can sign in.
DASH_USER=YOUR_USERNAME_HERE
DASH_PASS=YOUR_PASSWORD_HERE

# Optional. Signs the session cookie. When unset it is derived from the
# credentials above, so setting it is only needed if you want sessions to
# survive a password change.
# SESSION_SECRET=any-long-random-string
